# On DirectAdmin this project lives in public_html, but Laravel should run from
# the public/ directory. That is why every request is forwarded to public/
# here, so .env, vendor/, storage/ etc. cannot be requested from the browser.
# (Locally with `php artisan serve` or Herd this file is not used.)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not forward the Let's Encrypt checks of DirectAdmin
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Remove the trailing slash, otherwise /public/ ends up in the URL
    # (not for existing directories: Apache adds it again and causes a loop)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle everything else from public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite the whole project directory would be public: block everything
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
